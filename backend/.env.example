POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@127.0.0.1:5434/ubuzima
TEST_DATABASE_URL=postgresql+asyncpg://postgres:changeme@127.0.0.1:5434/ubuzima_test
OPENROUTER_API_KEY=changeme
LLM_MODEL=changeme/model-name
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# ENCRYPTION_KEY: base64 (urlsafe or standard) of exactly 32 random bytes (AES-256-GCM).
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=changeme-base64-of-32-random-bytes
# JWT_SECRET must be >= 32 chars (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=changeme-generate-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
RETENTION_DAYS=30
RETRIEVAL_MIN_SCORE=0.3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-1
TTS_MODEL=openai/tts-1
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=e5
STT_PROVIDER=openrouter
TTS_PROVIDER=openrouter
STORAGE_DIR=./var/uploads

# Optional first-admin bootstrap: if both are set and the account does not exist,
# the API creates this admin once on startup. Otherwise use `python -m app.cli create_admin`.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Realtime voice ICE. TURN is enabled only when TURN_SECRET is set (also used by the compose coturn service).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_SECRET=
TURN_REALM=ubuzima.local
TURN_TTL=3600

# Optional extra LLM providers (OpenAI-compatible). Each is enabled only when its key is set.
# The admin can switch the active provider+model from the dashboard (AI model section).
REQUESTY_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
AIONLABS_API_KEY=
HF_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DEFAULT_LLM_PROVIDER=requesty
DEFAULT_LLM_MODEL=google/gemma-4-31b-it

# --- Jev (TypeSafe System One) — structured decisions in the RAG pipeline -----------------
# Leave TYPESAFE_API_KEY empty to keep Jev OFF (the bot uses its LLM triage + plain retrieval).
# With a key set, Jev refines triage (calibrated category + confidence) and filters/re-ranks
# retrieved passages (drops prompt-injection + irrelevant chunks). Create a key at console.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TRIAGE_ENABLED=true
JEV_RERANK_ENABLED=true
